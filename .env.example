# Copy this file to .env and adjust values as needed.
# The application starts correctly with all defaults if no .env is present.

# Django core
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Gallery behaviour
IMAGE_DEFAULT_SIZE=medium        # small | medium | large
IMAGES_PER_PAGE=10               # default number of images shown per page

# Cache
CACHE_TTL=300                    # seconds; 0 disables caching

# Upstream resilience (picsum.dev)
UPSTREAM_TIMEOUT_SECONDS=5.0     # per-request timeout
UPSTREAM_RETRY_COUNT=3           # max retries on transient errors
UPSTREAM_BACKOFF_SECONDS=0.5     # base backoff; doubles each retry
